# 🤖 Ticketary Discord Bot - Environment Configuration Template

# 1. Discord Application settings
# Your bot token from Discord Developer Portal
DISCORD_BOT_TOKEN="YOUR_BOT_TOKEN_HERE"

# Your bot application client ID
CLIENT_ID="YOUR_CLIENT_ID_HERE"

# 2. Premium & Ownership Checks
# The Discord ID of the bot owner (e.g. 1262304052361035857)
PREMIUM_USER_ID="YOUR_USER_ID_HERE"

# 3. Web & Transcript Settings
# The public URL where the transcript pages will be visited.
# - If hosting directly on Pterodactyl/Render: e.g. http://your-pterodactyl-ip-or-domain:3000
# - If hosting on Vercel: e.g. https://ticketary-transcripts.vercel.app
TRANSCRIPT_WEB_URL="http://localhost:3000"

# Optional: Express port configuration (Default: 3000)
PORT=3000

# Secret key required for OAuth secure transcript endpoint requests
# (Ensure this matches the header token configuration if deploying to Vercel dashboard)
TRANSCRIPT_ACCESS_SECRET="YOUR_SECRET_ACCESS_KEY_HERE"

# Bot language locale: 'en' for English, 'vi' for Vietnamese
BOT_LANGUAGE="vi"

