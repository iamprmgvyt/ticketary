{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/emojis/(.*)",
      "dest": "/public/emojis/$1"
    },
    {
      "src": "/ticketary.png",
      "dest": "/public/ticketary.png"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.js"
    }
  ]
}